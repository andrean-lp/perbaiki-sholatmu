---
import { Icon } from "astro-icon/components";
---

<section id="cta" class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
  <div class="bg-emerald-900 rounded-3xl p-10 sm:p-16 text-center text-white relative overflow-hidden">
    <div class="max-w-3xl mx-auto space-y-6">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
        Sempurnakan Sholatmu, Raih Ketenangan Hakiki
      </h2>

      <p class="text-base sm:text-lg text-emerald-100/90 max-w-2xl mx-auto leading-relaxed">
        Jadikan ibadah sebagai penyejuk jiwa dan benteng diri melalui ketepatan waktu azan, tadabbur ayat suci Al-Qur'an, dan dzikir harian sesuai sunnah.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/jadwal-sholat"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-amber-400 text-emerald-950 hover:bg-amber-300 rounded-xl transition-colors font-bold text-base cursor-pointer"
        >
          <Icon name="tabler:clock" class="w-5 h-5" aria-hidden="true" />
          <span>Buka Jadwal Sholat Hari Ini</span>
        </a>
        <a
          href="/quran"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-emerald-800/80 hover:bg-emerald-800 text-white rounded-xl transition-colors font-semibold text-base cursor-pointer"
        >
          <Icon name="tabler:book-2" class="w-5 h-5 text-amber-300" aria-hidden="true" />
          <span>Baca Al-Qur'an 30 Juz</span>
        </a>
      </div>
    </div>
  </div>
</section>

---
import { Icon } from "astro-icon/components";
---

<section id="cta" class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
  <div class="bg-gradient-to-br from-gray-950 via-gray-900 to-black rounded-3xl p-8 sm:p-14 text-center text-white shadow-xl relative overflow-hidden border border-gray-800">
    <div class="relative z-10 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-xs font-semibold text-gray-200 mb-6 backdrop-blur-sm border border-white/10">
        <Icon name="tabler:sparkles" class="w-4 h-4 text-emerald-400" />
        <span>Langkah Kecil Menuju Perubahan Besar</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold mb-5 tracking-tight leading-tight">
        Mulai Perbaiki Sholatmu Hari Ini
      </h2>
      <p class="text-base sm:text-lg text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed">
        Jadikan sholat sebagai penyejuk hati dan benteng diri. Manfaatkan panduan jadwal tepat waktu, bacaan Al-Qur'an harian, dan doa yang diajarkan Rasulullah.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/jadwal-sholat"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white text-gray-950 rounded-xl hover:bg-gray-100 transition-all font-bold text-sm sm:text-base cursor-pointer shadow-md"
        >
          <Icon name="tabler:clock" class="w-5 h-5 text-gray-950" aria-hidden="true" />
          <span>Cek Jadwal Sholat</span>
        </a>
        <a
          href="/quran"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white/10 text-white rounded-xl hover:bg-white/20 transition-all font-semibold text-sm sm:text-base cursor-pointer border border-white/20 backdrop-blur-sm"
        >
          <Icon name="tabler:book-2" class="w-5 h-5" aria-hidden="true" />
          <span>Baca Al-Qur'an</span>
        </a>
      </div>
    </div>
  </div>
</section>

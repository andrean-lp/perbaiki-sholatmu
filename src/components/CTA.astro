---
import { Icon } from "astro-icon/components";
---

<section id="cta" class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
  <div class="bg-white rounded-3xl p-8 sm:p-14 text-center text-gray-900 shadow-sm relative overflow-hidden border border-gray-200">
    <div class="relative z-10 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-xs font-semibold text-emerald-800 mb-6 border border-emerald-200">
        <Icon name="tabler:sparkles" class="w-4 h-4 text-emerald-600" />
        <span>Langkah Kecil Menuju Perubahan Besar</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold mb-5 tracking-tight leading-tight text-gray-900">
        Mulai Perbaiki Sholatmu Hari Ini
      </h2>
      <p class="text-base sm:text-lg text-gray-600 mb-10 max-w-2xl mx-auto leading-relaxed">
        Jadikan sholat sebagai penyejuk hati dan benteng diri. Manfaatkan panduan jadwal tepat waktu, bacaan Al-Qur'an harian, dan doa yang diajarkan Rasulullah.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/jadwal-sholat"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-emerald-800 text-white rounded-xl hover:bg-emerald-900 transition-all font-bold text-sm sm:text-base cursor-pointer shadow-sm hover:shadow"
        >
          <Icon name="tabler:clock" class="w-5 h-5" aria-hidden="true" />
          <span>Cek Jadwal Sholat</span>
        </a>
        <a
          href="/quran"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white text-emerald-950 rounded-xl hover:bg-emerald-50/60 transition-all font-semibold text-sm sm:text-base cursor-pointer border border-emerald-200 hover:border-emerald-400"
        >
          <Icon name="tabler:book-2" class="w-5 h-5 text-emerald-800" aria-hidden="true" />
          <span>Baca Al-Qur'an</span>
        </a>
      </div>
    </div>
  </div>
</section>

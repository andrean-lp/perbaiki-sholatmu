---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
---

<section class="max-w-6xl mx-auto px-4 py-20 md:py-32 text-center" aria-labelledby="hero-heading">
  <ScrollReveal client:load>
    <h1 id="hero-heading" class="text-5xl md:text-6xl font-bold text-gray-900 mb-6">
      Perbaiki Sholatmu Agar Allah Perbaiki Hidupmu
    </h1>
  </ScrollReveal>
  <ScrollReveal client:load delay={0.2}>
    <div class="mb-8 max-w-3xl mx-auto">
      <p class="text-lg md:text-xl text-gray-700 italic leading-relaxed">
        &ldquo;Sesungguhnya amal yang pertama kali dihisab pada seorang hamba pada hari kiamat adalah shalatnya. Maka, jika shalatnya baik, sungguh ia telah beruntung dan berhasil. Dan jika shalatnya rusak, sungguh ia telah gagal dan rugi.&rdquo;
      </p>
      <p class="mt-3 text-xs md:text-sm text-gray-500 italic">
        HR. At-Tirmidzi no. 413, An-Nasa'i no. 465, dishahihkan oleh Syaikh Al Albani dalam Shahih Al Jami'
      </p>
    </div>
  </ScrollReveal>
  <ScrollReveal client:load delay={0.4}>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-8 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors font-medium"
        aria-label="Baca Artikel dan Panduan Sholat"
      >
        <Icon name="tabler:book-2" class="w-5 h-5" aria-hidden="true" />
        <span>Baca Panduan</span>
      </a>
      <a
        href="/about"
        class="inline-block px-8 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors font-medium"
      >
        Tentang Kami
      </a>
    </div>
  </ScrollReveal>
</section>

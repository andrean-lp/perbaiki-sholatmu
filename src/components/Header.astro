---
import { Icon } from "astro-icon/components";
---

<header
  class="w-full py-4 px-4 border-b border-gray-200 bg-white sticky top-0 z-50"
  role="banner"
>
  <nav
    class="max-w-6xl mx-auto flex items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="text-2xl font-bold text-gray-900 hover:text-gray-700 transition-colors"
      aria-label="Perbaiki Sholatmu - Beranda"
    >
      Perbaiki Sholatmu
    </a>
    
    <!-- Mobile menu button -->
    <button
      type="button"
      class="md:hidden p-2 text-gray-600 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 rounded-lg"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="mobile-menu-button"
    >
      <Icon name="tabler:menu-2" class="w-6 h-6" aria-hidden="true" />
    </button>

    <!-- Desktop navigation -->
    <ul class="hidden md:flex items-center gap-6" role="list">
      <li>
        <a
          href="/about"
          class="text-gray-600 hover:text-gray-900 transition-colors"
          aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}
        >
          Tentang Kami
        </a>
      </li>
      <li>
        <a
          href="/blog"
          class="text-gray-600 hover:text-gray-900 transition-colors"
          aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}
        >
          Blog
        </a>
      </li>

      <!-- Dropdown Lainnya (Khusus Menu Doa) -->
      <li class="relative group" id="desktop-dropdown-container">
        <button
          type="button"
          class="flex items-center gap-1.5 text-gray-600 hover:text-gray-900 transition-colors py-2 focus:outline-none cursor-pointer"
          id="desktop-dropdown-button"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Lainnya</span>
          <Icon
            name="tabler:chevron-down"
            class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
            id="desktop-dropdown-chevron"
            aria-hidden="true"
          />
        </button>

        <div
          id="desktop-dropdown-menu"
          class="hidden group-hover:block group-focus-within:block absolute right-0 top-full pt-2 w-56 z-50"
          role="menu"
        >
          <div class="bg-white rounded-xl shadow-lg border border-gray-100 py-2 ring-1 ring-black/5">
            <a
              href="/blog/doa-iftitah"
              class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-black transition-colors"
              role="menuitem"
            >
              Doa Iftitah
            </a>
            <a
              href="/blog/doa-ruku-sujud"
              class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-black transition-colors"
              role="menuitem"
            >
              Doa Ruku' & Sujud
            </a>
            <a
              href="/blog/doa-setelah-sholat"
              class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-black transition-colors"
              role="menuitem"
            >
              Doa Setelah Sholat
            </a>
          </div>
        </div>
      </li>

      <li>
        <a
          href="/contact"
          class="px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition-colors"
          aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}
        >
          Contact
        </a>
      </li>
    </ul>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-200 bg-white"
    role="menu"
    aria-labelledby="mobile-menu-button"
  >
    <ul class="flex flex-col py-4" role="list">
      <li>
        <a
          href="/about"
          class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}
        >
          Tentang Kami
        </a>
      </li>
      <li>
        <a
          href="/blog"
          class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}
        >
          Blog
        </a>
      </li>

      <!-- Mobile Dropdown Lainnya (Khusus Menu Doa) -->
      <li>
        <button
          type="button"
          id="mobile-dropdown-button"
          class="w-full flex items-center justify-between px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          aria-expanded="false"
        >
          <span>Lainnya</span>
          <Icon
            name="tabler:chevron-down"
            class="w-4 h-4 transition-transform duration-200"
            id="mobile-dropdown-chevron"
          />
        </button>
        <div id="mobile-dropdown-menu" class="hidden pl-6 py-1 bg-gray-50/80">
          <a
            href="/blog/doa-iftitah"
            class="block py-2 text-sm text-gray-600 hover:text-gray-900 transition-colors"
            role="menuitem"
          >
            Doa Iftitah
          </a>
          <a
            href="/blog/doa-ruku-sujud"
            class="block py-2 text-sm text-gray-600 hover:text-gray-900 transition-colors"
            role="menuitem"
          >
            Doa Ruku' & Sujud
          </a>
          <a
            href="/blog/doa-setelah-sholat"
            class="block py-2 text-sm text-gray-600 hover:text-gray-900 transition-colors"
            role="menuitem"
          >
            Doa Setelah Sholat
          </a>
        </div>
      </li>

      <li>
        <a
          href="/contact"
          class="block px-4 py-3 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}
        >
          Contact
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile main menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (
        !menuButton.contains(e.target as Node) &&
        !mobileMenu.contains(e.target as Node) &&
        !mobileMenu.classList.contains('hidden')
      ) {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
      }
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        menuButton.focus();
      }
    });
  }

  // Mobile 'Lainnya' dropdown toggle
  const mobileDropdownBtn = document.getElementById('mobile-dropdown-button');
  const mobileDropdownMenu = document.getElementById('mobile-dropdown-menu');
  const mobileDropdownChevron = document.getElementById('mobile-dropdown-chevron');

  if (mobileDropdownBtn && mobileDropdownMenu && mobileDropdownChevron) {
    mobileDropdownBtn.addEventListener('click', () => {
      const isExpanded = mobileDropdownBtn.getAttribute('aria-expanded') === 'true';
      mobileDropdownBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileDropdownMenu.classList.toggle('hidden');
      mobileDropdownChevron.classList.toggle('rotate-180');
    });
  }

  // Desktop 'Lainnya' dropdown click toggle (support touch & keyboard)
  const desktopDropdownBtn = document.getElementById('desktop-dropdown-button');
  const desktopDropdownMenu = document.getElementById('desktop-dropdown-menu');
  const desktopDropdownContainer = document.getElementById('desktop-dropdown-container');

  if (desktopDropdownBtn && desktopDropdownMenu && desktopDropdownContainer) {
    desktopDropdownBtn.addEventListener('click', () => {
      const isHidden = desktopDropdownMenu.classList.contains('hidden');
      if (isHidden) {
        desktopDropdownMenu.classList.remove('hidden');
        desktopDropdownBtn.setAttribute('aria-expanded', 'true');
      } else {
        desktopDropdownMenu.classList.add('hidden');
        desktopDropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });

    // Click outside to close desktop dropdown
    document.addEventListener('click', (e) => {
      if (!desktopDropdownContainer.contains(e.target as Node)) {
        desktopDropdownMenu.classList.add('hidden');
        desktopDropdownBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

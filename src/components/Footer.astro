---
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="w-full py-12 px-4 border-t border-gray-200 bg-white"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Perbaiki Sholatmu</h2>
        <p class="text-gray-600">
          Panduan dan inspirasi untuk memperbaiki kualitas dan kekhusyukan sholat kita sehari-hari.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Links</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/jadwal-sholat"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Jadwal Sholat</a
            >
          </li>
          <li>
            <a
              href="/kajian"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Info Kajian Sunnah</a
            >
          </li>
          <li>
            <a
              href="/features"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Features</a
            >
          </li>
          <li>
            <a
              href="/tentang"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Tentang</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Media Sosial</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="https://www.youtube.com/@qataquran"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener"
              aria-label="Kunjungi YouTube Qata Quran (buka di tab baru)"
            >
              <Icon name="tabler:brand-youtube" class="w-5 h-5 text-red-600" aria-hidden="true" />
              <span>YouTube</span></a
            >
          </li>
          <li>
            <a
              href="https://id.pinterest.com/qataquran/"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener"
              aria-label="Kunjungi Pinterest Qata Quran (buka di tab baru)"
            >
              <Icon name="tabler:brand-pinterest" class="w-5 h-5 text-red-700" aria-hidden="true" />
              <span>Pinterest</span></a
            >
          </li>
          <li>
            <a
              href="/terms"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
            >
              <Icon name="tabler:file-text" class="w-5 h-5 text-gray-500" aria-hidden="true" />
              <span>Terms of Service</span></a
            >
          </li>
          <li>
            <a
              href="/privacy"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
            >
              <Icon name="tabler:shield" class="w-5 h-5 text-gray-500" aria-hidden="true" />
              <span>Privacy Policy</span></a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-gray-200 text-center text-gray-600">
      <p>
        &copy; <span id="footer-year">{new Date().getFullYear()}</span> <a
          href="https://www.youtube.com/@qataquran"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-gray-800 hover:text-emerald-700 transition-colors"
        >Qata Quran</a>. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  const yearEl = document.getElementById("footer-year");
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear().toString();
  }
</script>

---
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="w-full py-14 px-4 bg-gray-50/90 text-gray-700"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-12">
      <!-- Info Brand & Statistik mirip equran.id -->
      <div class="md:col-span-6 lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center p-1.5 shrink-0">
            <img
              src="/uploads/qata-quran-icon.png"
              alt="Logo Qata Quran"
              class="w-9 h-9 object-contain"
              width="36"
              height="36"
              loading="lazy"
            />
          </div>
          <div>
            <a
              href="/"
              class="text-xl font-bold text-gray-900 hover:text-emerald-700 transition-colors tracking-tight flex items-center gap-1.5"
            >
              Qata Quran
            </a>
            <p class="text-xs text-emerald-700 font-medium">Al-Qur'an & Panduan Sholat Digital</p>
          </div>
        </div>
        <p class="text-sm text-gray-600 leading-relaxed max-w-md">
          Platform Al-Qur'an digital dan panduan ibadah terlengkap untuk memperbaiki kualitas dan kekhusyukan sholat, dilengkapi terjemahan bahasa Indonesia, audio murottal 6 qari internasional, tafsir Kemenag, jadwal sholat presisi, dan kumpulan doa harian.
        </p>
        <div class="flex items-center gap-8 pt-2">
          <div>
            <div class="text-2xl font-bold text-gray-900 tracking-tight">114</div>
            <div class="text-xs text-gray-500 font-medium">Surat</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-gray-900 tracking-tight">6.236</div>
            <div class="text-xs text-gray-500 font-medium">Ayat</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-gray-900 tracking-tight">6</div>
            <div class="text-xs text-gray-500 font-medium">Qari</div>
          </div>
        </div>
      </div>
      <div class="md:col-span-3 lg:col-span-4 lg:pl-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Layanan & Menu</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/jadwal-sholat"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Jadwal Sholat</a
            >
          </li>
          <li>
            <a
              href="/quran"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Al-Qur'an 30 Juz</a
            >
          </li>
          <li>
            <a
              href="/doa"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Kumpulan Doa Harian</a
            >
          </li>
          <li>
            <a
              href="/kajian"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Info Kajian Sunnah</a
            >
          </li>
          <li>
            <a
              href="/artikel"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Artikel & Panduan</a
            >
          </li>
          <li>
            <a
              href="/tentang"
              class="text-gray-600 hover:text-gray-900 transition-colors"
              >Tentang Kami</a
            >
          </li>
        </ul>
      </div>
      <div class="md:col-span-3 lg:col-span-3">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Media Sosial</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="https://www.youtube.com/@qataquran"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Kunjungi YouTube Qata Quran (buka di tab baru)"
            >
              <Icon name="tabler:brand-youtube" class="w-5 h-5 text-gray-500" aria-hidden="true" />
              <span>YouTube</span></a
            >
          </li>
          <li>
            <a
              href="https://id.pinterest.com/qataquran/"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Kunjungi Pinterest Qata Quran (buka di tab baru)"
            >
              <Icon name="tabler:brand-pinterest" class="w-5 h-5 text-gray-500" aria-hidden="true" />
              <span>Pinterest</span></a
            >
          </li>
          <li>
            <a
              href="/terms"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
            >
              <Icon name="tabler:file-text" class="w-5 h-5 text-gray-500" aria-hidden="true" />
              <span>Terms of Service</span></a
            >
          </li>
          <li>
            <a
              href="/privacy"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
            >
              <Icon name="tabler:shield" class="w-5 h-5 text-gray-500" aria-hidden="true" />
              <span>Privacy Policy</span></a
            >
          </li>
          <li>
            <a
              href="/sitemap-index.xml"
              class="flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="tabler:sitemap" class="w-5 h-5 text-gray-500" aria-hidden="true" />
              <span>Sitemap</span></a
            >
          </li>
        </ul>
      </div>
    </div>
    <div data-ui class="pt-8 border-t border-gray-200/80 text-center text-gray-500 text-xs sm:text-sm">
      <p>
        &copy; <span id="footer-year">{new Date().getFullYear()}</span> Perbaiki Sholatmu by <a
          href="https://www.youtube.com/@qataquran"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-gray-800 hover:text-emerald-700 transition-colors"
        >Qata Quran</a>. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  const yearEl = document.getElementById("footer-year");
  if (yearEl) {
    yearEl.textContent = new Date().getFullYear().toString();
  }
</script>

---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TableOfContents, { type TocItem } from "../../components/TableOfContents.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../config/site.mjs";

const pageTitle = "Panduan Tata Cara Sholat Sesuai Sunnah - Bab 2 Perbaiki Sholatmu";
const pageDescription = "Panduan lengkap tata cara sholat wajib 5 waktu sesuai sunnah Nabi SAW dan rujukan 4 mazhab. Dilengkapi bacaan doa tiap gerakan, teks Arab berharakat, rukun, dan syarat sah.";
const pageUrl = `${SITE.url}/perbaiki-sholat/sholat`;

const tocItems: TocItem[] = [
  {
    title: "Arti dan Hakikat Sholat dalam Islam",
    href: "#arti-hakikat-sholat",
  },
  {
    title: "Kapan Sholat Diwajibkan dan Adab Membawa Anak ke Masjid",
    href: "#kapan-sholat-diwajibkan",
  },
  {
    title: "8 Syarat Sah Sholat",
    href: "#syarat-sah-sholat",
  },
  {
    title: "13 Rukun Sholat",
    href: "#rukun-sholat",
  },
  {
    title: "12 Hal yang Membatalkan Sholat",
    href: "#hal-yang-membatalkan-sholat",
  },
  {
    title: "14 Tahapan Tata Cara Pelaksanaan Sholat Lengkap",
    href: "#tata-cara-pelaksanaan-sholat",
    children: [
      { title: "1. Berdiri Menghadap Kiblat", href: "#langkah-1-kiblat" },
      { title: "2. Niat Sholat 5 Waktu", href: "#langkah-2-niat" },
      { title: "3. Takbiratul Ihram", href: "#langkah-3-takbir" },
      { title: "4. Bersedekap dan Doa Iftitah", href: "#langkah-4-iftitah" },
      { title: "5. Membaca Surah Al-Fatihah", href: "#langkah-5-alfatihah" },
      { title: "6. Membaca Surah Pendek", href: "#langkah-6-surah" },
      { title: "7. Rukuk dan Bacaan Tasbih", href: "#langkah-7-rukuk" },
      { title: "8. I'tidal dan Bacaan Tahmid", href: "#langkah-8-itidal" },
      { title: "9. Sujud dan Kenikmatan Munajat", href: "#langkah-9-sujud" },
      { title: "10. Duduk di Antara Dua Sujud", href: "#langkah-10-duduk" },
      { title: "11. Sujud Kedua", href: "#langkah-11-sujud-kedua" },
      { title: "12. Tasyahud Awal", href: "#langkah-12-tasyahud-awal" },
      { title: "13. Tasyahud Akhir dan Sholawat", href: "#langkah-13-tasyahud-akhir" },
      { title: "14. Salam dan Penutup Sholat", href: "#langkah-14-salam" },
    ],
  },
  {
    title: "5 Tujuan Utama Disyariatkannya Sholat",
    href: "#tujuan-disyariatkan-sholat",
  },
  {
    title: "Tanya Jawab Seputar Sholat (FAQ)",
    href: "#faq-seputar-sholat",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Panduan Tata Cara Sholat Sesuai Sunnah Nabi dan 4 Mazhab",
      "description": pageDescription,
      "inLanguage": "id-ID",
      "mainEntityOfPage": pageUrl,
      "publisher": {
        "@type": "Organization",
        "name": "Qata Quran",
        "logo": {
          "@type": "ImageObject",
          "url": `${SITE.url}/uploads/qata-quran-logo.png`
        }
      }
    },
    {
      "@type": "HowTo",
      "name": "Tata Cara Sholat Sesuai Sunnah",
      "description": "Urutan tata cara sholat dari takbiratul ihram hingga salam lengkap dengan bacaan doa dan gerakan sesuai sunnah Rasulullah SAW.",
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Berdiri Menghadap Kiblat" },
        { "@type": "HowToStep", "position": 2, "name": "Berniat Ibadah Sholat" },
        { "@type": "HowToStep", "position": 3, "name": "Takbiratul Ihram" },
        { "@type": "HowToStep", "position": 4, "name": "Bersedekap dan Membaca Doa Iftitah" },
        { "@type": "HowToStep", "position": 5, "name": "Membaca Surah Al-Fatihah" },
        { "@type": "HowToStep", "position": 6, "name": "Membaca Surah atau Ayat Al-Qur'an" },
        { "@type": "HowToStep", "position": 7, "name": "Rukuk dengan Thuma'ninah" },
        { "@type": "HowToStep", "position": 8, "name": "I'tidal dengan Thuma'ninah" },
        { "@type": "HowToStep", "position": 9, "name": "Sujud Pertama dengan Thuma'ninah" },
        { "@type": "HowToStep", "position": 10, "name": "Duduk di Antara Dua Sujud" },
        { "@type": "HowToStep", "position": 11, "name": "Sujud Kedua" },
        { "@type": "HowToStep", "position": 12, "name": "Duduk Tasyahud Awal" },
        { "@type": "HowToStep", "position": 13, "name": "Duduk Tasyahud Akhir dan Membaca Sholawat" },
        { "@type": "HowToStep", "position": 14, "name": "Mengucapkan Salam" }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header />

  <main id="main-content" role="main" class="max-w-4xl mx-auto px-4 py-12 sm:py-16 space-y-12">
    <!-- Breadcrumb Navigasi -->
    <nav aria-label="Breadcrumb" class="text-xs sm:text-sm text-gray-500">
      <ol class="flex items-center gap-2 flex-wrap">
        <li>
          <a href="/" class="hover:text-emerald-800 transition-colors">Beranda</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <span class="text-gray-700">Perbaiki Sholat</span>
        </li>
        <li aria-hidden="true">/</li>
        <li class="font-semibold text-emerald-900" aria-current="page">
          Bab 2 : Sholat
        </li>
      </ol>
    </nav>

    <!-- Header Artikel & H1 -->
    <header class="space-y-4 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-xs font-semibold text-emerald-800 border border-emerald-200">
        <span>Modul Fikih &bull; Bab 2</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
        Panduan Tata Cara Sholat Sesuai Sunnah Nabi dan 4 Mazhab
      </h1>
      <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
        Menyelami hakikat ibadah sholat, syarat sah, rukun, variasi bacaan doa tiap gerakan, hingga rahasia meraih kenikmatan munajat di hadapan Allah SWT.
      </p>
    </header>

    <!-- Key Takeaways / TL;DR (GEO & AEO Optimization) -->
    <section class="p-6 sm:p-8 bg-emerald-50/70 rounded-3xl space-y-4 text-left">
      <h2 class="text-lg font-bold text-emerald-950 flex items-center gap-2">
        <Icon name="tabler:sparkles" class="w-5 h-5 text-emerald-800" aria-hidden="true" />
        <span>Poin Inti Tata Cara Sholat (TL;DR)</span>
      </h2>
      <ul class="space-y-2 text-sm sm:text-base text-gray-700 leading-relaxed list-disc list-inside">
        <li><strong>Tiang Agama:</strong> Sholat adalah amalan pertama yang dihisab pada hari kiamat dan menjadi pembeda utama keimanan seorang muslim.</li>
        <li><strong>8 Syarat & 13 Rukun:</strong> Keabsahan sholat bergantung pada terpenuhinya syarat sah (seperti wudhu dan waktu) serta 13 rukun wajib secara tertib dengan thuma'ninah.</li>
        <li><strong>Khilaf Tanawwu' yang Indah:</strong> Posisi bersedekap, tinggi takbir, dan bacaan iftitah memiliki variasi shahih dari 4 mazhab yang semuanya bersumber dari sunnah Nabi SAW.</li>
        <li><strong>Bermunajat dengan Allah:</strong> Setiap gerakan sholat menyimpan dialog langsung dengan Allah, terutama saat pembacaan Surah Al-Fatihah dan posisi terdekat ketika bersujud.</li>
      </ul>
    </section>

    <!-- Table of Contents (Daftar Isi Panduan) -->
    <TableOfContents items={tocItems} />

    <!-- Bagian 1: Arti dan Hakikat Sholat -->
    <section class="space-y-4 text-left">
      <h2 id="arti-hakikat-sholat" class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight scroll-mt-24">
        Arti dan Hakikat Sholat dalam Islam
      </h2>
      <p class="text-base text-gray-700 leading-relaxed">
        Secara etimologi (bahasa Arab), kata sholat memiliki beberapa makna utama, di antaranya adalah doa (sebagaimana firman Allah dalam QS. At-Taubah: 103), rahmat, dan permohonan ampunan (QS. Al-Ahzab: 43 dan 56). Sedangkan secara terminologi syariat, sholat adalah serangkaian ucapan dan perbuatan khusus yang diawali dengan takbiratul ihram dan diakhiri dengan salam, disertai niat dan syarat-syarat tertentu.
      </p>
      <p class="text-base text-gray-700 leading-relaxed">
        Kewajiban mendirikan sholat ditegaskan di banyak ayat Al-Qur'an dan hadits shahih Rasulullah SAW, di antaranya:
      </p>

      <div class="p-6 bg-white rounded-2xl space-y-3 border border-emerald-100 shadow-sm">
        <p dir="rtl" class="font-arabic text-xl sm:text-2xl leading-loose text-right text-gray-900">
          وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَارْكَعُوا مَعَ الرَّاكِعِينَ
        </p>
        <p class="text-sm text-gray-700 italic leading-relaxed">
          &ldquo;Dan tegakkanlah sholat, tunaikanlah zakat, dan rukuklah beserta orang-orang yang rukuk.&rdquo;
        </p>
        <p class="text-xs font-semibold text-emerald-800">
          QS. Al-Baqarah: 43
        </p>
      </div>

      <div class="p-6 bg-white rounded-2xl space-y-3 border border-emerald-100 shadow-sm">
        <p dir="rtl" class="font-arabic text-xl sm:text-2xl leading-loose text-right text-gray-900">
          وَأَقِمِ الصَّلَاةَ إِنَّ الصَّلَاةَ تَنْهَىٰ عَنِ الْفَحْشَاءِ وَالْمُنْكَرِ
        </p>
        <p class="text-sm text-gray-700 italic leading-relaxed">
          &ldquo;Dan tegakkanlah sholat. Sesungguhnya sholat itu mencegah dari (perbuatan) keji dan mungkar.&rdquo;
        </p>
        <p class="text-xs font-semibold text-emerald-800">
          QS. Al-Ankabut: 45
        </p>
      </div>
    </section>

    <!-- Bagian 2: Kapan Sholat Diwajibkan & Anak ke Masjid -->
    <section class="space-y-4 text-left">
      <h2 id="kapan-sholat-diwajibkan" class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight scroll-mt-24">
        Kapan Seseorang Diwajibkan Sholat dan Adab Membawa Anak ke Masjid
      </h2>
      <p class="text-base text-gray-700 leading-relaxed">
        Rasulullah shallallahu 'alaihi wa sallam meletakkan panduan tahapan pendidikan sholat bagi buah hati sejak dini melalui sabda beliau:
      </p>

      <div class="p-6 bg-white rounded-2xl space-y-2 border border-emerald-100 shadow-sm">
        <p class="text-sm sm:text-base text-gray-800 font-medium italic leading-relaxed">
          &ldquo;Perintahkanlah anak-anakmu untuk melaksanakan sholat ketika mereka berumur tujuh tahun, dan pukullah mereka (dengan pukulan mendidik) jika meninggalkannya ketika berusia sepuluh tahun, serta pisahkanlah tempat tidur mereka.&rdquo;
        </p>
        <p class="text-xs font-semibold text-emerald-800">
          HR. Abu Daud no. 495 dan Ahmad no. 6689
        </p>
      </div>

      <p class="text-sm text-gray-600 leading-relaxed">
        <strong>Catatan Mendidik:</strong> Pukulan yang dimaksud bukanlah pukulan kemarahan, tidak boleh mengenai wajah atau organ vital, tidak meninggalkan lebam, serta tidak memicu trauma mental pada anak. Tujuannya murni menanamkan disiplin ibadah.
      </p>

      <h3 class="text-lg font-bold text-gray-900 pt-2">
        3 Kategori Usia Anak saat Dibawa ke Masjid:
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-2">
          <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200">1. Shabi (&lt; 5 Tahun)</span>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed">
            Belum bisa merespon instruksi dan rawan buang air. Lebih utama dijaga di rumah kecuali dalam pengawasan ketat orang tua.
          </p>
        </div>
        <div class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-2">
          <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200">2. Mumayyiz (5-10 Tahun)</span>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed">
            Sudah bisa membedakan baik dan buruk serta merespon arahan. Sangat dianjurkan dibawa ke masjid untuk pembiasaan sholat berjamaah.
          </p>
        </div>
        <div class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-2">
          <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200">3. Aqil Baligh (&gt; 10 Tahun)</span>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed">
            Sudah terkena beban hukum taklif (kewajiban syariat penuh). Wajib bergabung dalam barisan shaf orang dewasa dengan tertib.
          </p>
        </div>
      </div>

      <div class="p-6 bg-emerald-50/70 rounded-2xl space-y-2">
        <p class="text-sm font-bold text-emerald-950">Solusi Shaf Anak-Anak di Masjid:</p>
        <p class="text-xs sm:text-sm text-gray-700 leading-relaxed">
          Anak-anak terkadang memutus kesempurnaan shaf karena belum dikhitan atau wudhunya belum sempurna. Solusinya, buatkan shaf khusus anak-anak di barisan belakang atau selingi mereka di samping orang tua masing-masing untuk diawasi. Jangan sekali-kali mengusir anak-anak dari masjid agar kecintaan mereka pada rumah Allah tidak pudar.
        </p>
      </div>
    </section>

    <!-- Bagian 3: 8 Syarat Sah Sholat -->
    <section class="space-y-4 text-left">
      <h2 id="syarat-sah-sholat" class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight scroll-mt-24">
        8 Syarat Sah Sholat
      </h2>
      <p class="text-base text-gray-700 leading-relaxed">
        Syarat sah adalah hal-hal yang wajib dipenuhi sebelum sholat dimulai agar ibadah sholat bernilai sah di mata syariat:
      </p>

      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-4 list-none">
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 1</span>
          <h3 class="text-base font-bold text-gray-900">Beragama Islam</h3>
          <p class="text-xs sm:text-sm text-gray-600">Syarat mutlak diterimanya seluruh ibadah pokok dalam syariat Islam.</p>
        </li>
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 2</span>
          <h3 class="text-base font-bold text-gray-900">Sudah Baligh dan Berakal</h3>
          <p class="text-xs sm:text-sm text-gray-600">Tidak ada kewajiban sholat bagi anak kecil yang belum baligh dan orang hilang akal.</p>
        </li>
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 3</span>
          <h3 class="text-base font-bold text-gray-900">Suci dari Hadats Kecil dan Besar</h3>
          <p class="text-xs sm:text-sm text-gray-600">Bersuci melalui wudhu (hadats kecil) atau mandi wajib (hadats besar).</p>
        </li>
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 4</span>
          <h3 class="text-base font-bold text-gray-900">Suci Badan, Pakaian, dan Tempat</h3>
          <p class="text-xs sm:text-sm text-gray-600">Bersih dari segala macam najis 'ainiyah maupun hukmiyah yang tidak dimaafkan.</p>
        </li>
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 5</span>
          <h3 class="text-base font-bold text-gray-900">Menutup Aurat</h3>
          <p class="text-xs sm:text-sm text-gray-600">Laki-laki antara pusar dan lutut; wanita seluruh tubuh kecuali wajah dan kedua telapak tangan.</p>
        </li>
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 6</span>
          <h3 class="text-base font-bold text-gray-900">Masuk Waktu Sholat</h3>
          <p class="text-xs sm:text-sm text-gray-600">Sholat tidak sah bila dikerjakan mendahului masuknya waktu yang telah ditetapkan syariat.</p>
        </li>
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 7</span>
          <h3 class="text-base font-bold text-gray-900">Menghadap Kiblat</h3>
          <p class="text-xs sm:text-sm text-gray-600">Menghadapkan dada lurus ke arah Ka'bah di Masjidil Haram (Makkah Al-Mukarramah).</p>
        </li>
        <li class="p-5 bg-white rounded-2xl border border-gray-100 shadow-sm space-y-1">
          <span class="text-xs font-bold text-emerald-800">Syarat 8</span>
          <h3 class="text-base font-bold text-gray-900">Mengetahui Rukun dan Sunnah</h3>
          <p class="text-xs sm:text-sm text-gray-600">Memahami mana gerakan yang wajib dipenuhi dan mana amalan yang berstatus anjuran.</p>
        </li>
      </ol>
    </section>

    <!-- Bagian 4: 13 Rukun Sholat -->
    <section class="space-y-4 text-left">
      <h2 id="rukun-sholat" class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight scroll-mt-24">
        13 Rukun Sholat
      </h2>
      <p class="text-base text-gray-700 leading-relaxed">
        Rukun adalah bagian hakiki dari sholat yang wajib dikerjakan. Jika tertinggal salah satunya secara sengaja, maka sholatnya batal:
      </p>

      <div class="p-6 bg-white rounded-3xl border border-emerald-100 shadow-sm space-y-3">
        <ol class="space-y-2 text-sm sm:text-base text-gray-700 list-decimal list-inside leading-relaxed marker:text-emerald-700 marker:font-semibold">
          <li><strong>Niat:</strong> Dihadirkan di dalam hati berbarengan dengan takbiratul ihram.</li>
          <li><strong>Takbiratul Ihram:</strong> Melafadzkan kalimat <em>Allahu Akbar</em> di awal sholat.</li>
          <li><strong>Berdiri Tegak:</strong> Wajib bagi yang mampu saat sholat fardhu (boleh duduk atau berbaring jika sakit).</li>
          <li><strong>Membaca Surah Al-Fatihah:</strong> Wajib pada tiap-tiap rakaat.</li>
          <li><strong>Rukuk dengan Thuma'ninah:</strong> Membungkuk tenang sekurang-kurangnya selama membaca satu kali tasbih.</li>
          <li><strong>I'tidal dengan Thuma'ninah:</strong> Bangkit berdiri tegak lurus dengan tenang setelah rukuk.</li>
          <li><strong>Sujud Dua Kali dengan Thuma'ninah:</strong> Meletakkan 7 anggota sujud ke lantai pada setiap rakaat.</li>
          <li><strong>Duduk di Antara Dua Sujud dengan Thuma'ninah:</strong> Duduk iftirasy dengan tenang di antara dua sujud.</li>
          <li><strong>Duduk Tasyahud Akhir:</strong> Posisi duduk tawarruk pada rakaat terakhir.</li>
          <li><strong>Membaca Bacaan Tasyahud Akhir:</strong> Melafadzkan tahiyyat akhir secara sempurna.</li>
          <li><strong>Membaca Sholawat Nabi SAW:</strong> Bersholawat kepada Nabi Muhammad SAW pada tasyahud akhir.</li>
          <li><strong>Membaca Salam Pertama:</strong> Mengucapkan salam seraya menoleh ke arah kanan.</li>
          <li><strong>Tertib:</strong> Mengerjakan rukun-rukun tersebut secara berurutan dari awal hingga akhir.</li>
        </ol>
      </div>
    </section>

    <!-- Bagian 5: 12 Hal yang Membatalkan Sholat -->
    <section class="space-y-4 text-left">
      <h2 id="hal-yang-membatalkan-sholat" class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight scroll-mt-24">
        12 Hal yang Membatalkan Sholat
      </h2>
      <p class="text-base text-gray-700 leading-relaxed">
        Ibadah sholat menjadi batal dan wajib diulang apabila terjadi salah satu dari 12 perkara berikut:
      </p>

      <div class="p-6 sm:p-8 bg-white rounded-3xl border border-emerald-100 shadow-sm space-y-3">
        <ol class="space-y-2.5 text-sm sm:text-base text-gray-700 list-decimal list-inside leading-relaxed marker:text-emerald-700 marker:font-semibold">
          <li>Berhadats kecil maupun hadats besar.</li>
          <li>Terkena najis yang tidak dimaafkan pada tubuh atau pakaian.</li>
          <li>Berkata-kata sengaja meski hanya satu huruf yang berfaedah.</li>
          <li>Terbukanya aurat bila tidak segera ditutup seketika.</li>
          <li>Mengubah niat sholat (misalnya berniat membatalkannya).</li>
          <li>Makan atau minum dengan sengaja walau hanya sedikit.</li>
          <li>Bergerak berturut-turut tiga kali (seperti tiga langkah kaki).</li>
          <li>Membelakangi arah kiblat dengan dadanya.</li>
          <li>Menambah rukun fi'li (seperti sengaja rukuk atau sujud dua kali).</li>
          <li>Tertawa terbahak-bahak hingga mengeluarkan suara.</li>
          <li>Mendahului imam sebanyak dua rukun fi'li berturut-turut.</li>
          <li>Murtad (keluar dari agama Islam).</li>
        </ol>
      </div>

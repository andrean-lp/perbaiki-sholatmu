---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";

const values = [
  {
    title: "Al-Qur'an & As-Sunnah",
    desc: "Seluruh panduan ibadah disandarkan pada dalil nash Al-Qur'an dan sunnah Rasulullah shallallahu 'alaihi wa sallam dengan pemahaman yang shahih.",
    icon: "tabler:book-2",
  },
  {
    title: "Rujukan Resmi Terverifikasi",
    desc: "Menggunakan data mushaf standar Kemenag RI, takhrij hadits mu'tabar, serta jadwal hisab/rukyat resmi kementerian.",
    icon: "tabler:shield-check",
  },
  {
    title: "Mudah & Aksesibel",
    desc: "Didesain ringan, cepat dibuka di berbagai perangkat, tanpa iklan yang mengganggu kekhusyukan dan fokus pembaca.",
    icon: "tabler:device-mobile",
  },
  {
    title: "Inspirasi Berkelanjutan",
    desc: "Menyediakan artikel harian, jadwal kajian ilmiah, dan doa-doa mustajab untuk terus memotivasi perbaikan diri.",
    icon: "tabler:sparkles",
  },
];
---

<Layout
  title={`Tentang Kami - ${SITE.title}`}
  description="Mengenal visi, misi, dan komitmen Perbaiki Sholatmu dalam menyajikan panduan sholat, Al-Qur'an digital, jadwal sholat, dan rujukan ibadah terpercaya."
  canonicalURL={`${SITE.url}/tentang`}
>
  <Header />

  <main id="main-content" role="main" class="max-w-5xl mx-auto px-4 py-14 sm:py-20 space-y-16">
    <!-- Hero Header -->
    <header class="text-left max-w-3xl">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-6 leading-tight">
        Perbaiki Sholatmu Agar Allah Perbaiki Hidupmu
      </h1>
      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed">
        Platform media dakwah digital yang berikhtiar mendampingi kaum muslimin untuk meraih kekhusyukan dan kesempurnaan ibadah sholat sehari-hari sesuai tuntunan Al-Qur'an dan As-Sunnah.
      </p>
    </header>

    <!-- Kutipan Landasan Hadits -->
    <section class="p-8 sm:p-10 bg-amber-50/70 rounded-3xl text-left">
      <div class="max-w-3xl">
        <blockquote class="text-lg sm:text-xl text-amber-950 font-serif italic leading-relaxed">
          &ldquo;Sesungguhnya amal yang pertama kali dihisab pada seorang hamba pada hari kiamat adalah <strong class="font-bold">sholatnya</strong>. Maka, jika sholatnya baik, sungguh ia telah beruntung dan berhasil. Dan jika shalatnya rusak, sungguh ia telah gagal dan rugi.&rdquo;
        </blockquote>
        <p class="mt-4 text-xs sm:text-sm text-amber-800 font-medium">
          HR. At-Tirmidzi no. 413, An-Nasa'i no. 465, dishahihkan oleh Syaikh Al-Albani dalam Shahih Al Jami'
        </p>
      </div>
    </section>

    <!-- Inisiatif & Pengembang: Dibuat oleh Qata Quran -->
    <section class="p-8 sm:p-12 bg-emerald-50/70 rounded-3xl">
      <div class="grid md:grid-cols-12 gap-8 sm:gap-10 items-center">
        <!-- Logo Qata Quran Container -->
        <div class="md:col-span-4 flex justify-center">
          <div class="p-6 rounded-2xl bg-white flex items-center justify-center max-w-[240px]">
            <img
              src="/uploads/qata-quran-logo.png"
              alt="Logo Resmi Qata Quran"
              class="w-full h-auto object-contain"
              width="240"
              height="328"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Uraian Hubungan & Komitmen -->
        <div class="md:col-span-8 space-y-4 text-left">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight leading-snug">
            Perbaiki Sholatmu Dikembangkan oleh Qata Quran
          </h2>

          <p class="text-gray-700 leading-relaxed text-base">
            Platform <strong>Perbaiki Sholatmu</strong> lahir dan dikembangkan sebagai bagian dari dedikasi dakwah digital <strong>Qata Quran</strong>. Kami berikhtiar menghadirkan sarana praktis bagi kaum muslimin untuk memperbaiki kualitas sholat, menjaga waktu ibadah, dan mendalami hikmah ayat suci Al-Qur'an dalam kehidupan sehari-hari.
          </p>

          <p class="text-gray-700 leading-relaxed text-base">
            Dengan komitmen menyajikan konten yang bersumber dari dalil shahih, rujukan resmi Kementerian Agama RI, data jadwal sholat presisi, serta lantunan murottal dari para qari internasional, Qata Quran mengelola platform ini agar senantiasa bermanfaat, menenangkan hati, dan menjadi amal jariyah yang berkesinambungan.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="https://www.youtube.com/@qataquran"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-800 text-white rounded-xl text-xs sm:text-sm font-semibold hover:bg-emerald-900 transition-colors"
            >
              <Icon name="tabler:brand-youtube" class="w-4 h-4 text-red-400" />
              <span>YouTube Channel @qataquran</span>
            </a>
            <a
              href="https://id.pinterest.com/qataquran/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-gray-800 rounded-xl text-xs sm:text-sm font-semibold hover:bg-emerald-100/70 hover:text-emerald-900 transition-colors"
            >
              <Icon name="tabler:brand-pinterest" class="w-4 h-4 text-rose-500" />
              <span>Pinterest @qataquran</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Visi & Misi -->
    <section class="grid md:grid-cols-2 gap-8">
      <div class="p-8 bg-gray-50/80 rounded-3xl flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 bg-emerald-100 text-emerald-900 rounded-2xl flex items-center justify-center mb-5">
            <Icon name="tabler:target" class="w-6 h-6" />
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">Visi Kami</h2>
          <p class="text-gray-700 leading-relaxed text-base">
            Menjadi platform panduan ibadah sholat digital terdepan yang terpercaya, menumbuhkan kesadaran umat akan urgensi sholat tepat waktu, serta menghidupkan nilai-nilai kekhusyukan dalam kehidupan sehari-hari.
          </p>
        </div>
      </div>

      <div class="p-8 bg-gray-50/80 rounded-3xl flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 bg-emerald-100 text-emerald-900 rounded-2xl flex items-center justify-center mb-5">
            <Icon name="tabler:compass" class="w-6 h-6" />
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">Misi Kami</h2>
          <ul class="space-y-3 text-gray-700 text-base leading-relaxed list-disc list-inside">
            <li>Menyajikan panduan tata cara sholat praktis berdasarkan sunnah shahihah.</li>
            <li>Menyediakan perkakas ibadah harian seperti jadwal sholat akurat dan Al-Qur'an 30 juz.</li>
            <li>Menyebarkan artikel pengingat dan hikmah yang aplikatif untuk menjaga keistiqamahan ibadah.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Nilai & Komitmen Kami -->
    <section class="space-y-8">
      <div class="text-left max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Nilai & Komitmen Layanan</h2>
        <p class="text-gray-600 text-base">
          Prinsip dasar yang kami pegang teguh dalam menghadirkan setiap baris konten dan fitur.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {values.map((v) => (
          <div class="p-6 sm:p-7 bg-gray-50/80 rounded-2xl space-y-3">
            <div class="w-10 h-10 bg-emerald-100 text-emerald-900 rounded-xl flex items-center justify-center">
              <Icon name={v.icon} class="w-5 h-5" />
            </div>
            <h3 class="text-lg font-bold text-gray-900">{v.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Kolaborasi & Media (Inverted Dark Green Surface) -->
    <section class="p-8 sm:p-12 bg-emerald-900 text-white rounded-3xl text-left">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3 tracking-tight">Terhubung Bersama Kami</h2>
        <p class="text-emerald-100/90 mb-8 text-sm sm:text-base leading-relaxed">
          Ikuti konten dakwah visual dan lantunan tilawah harian kami di media sosial, atau hubungi kami untuk masukan dan saran penyempurnaan platform.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="https://www.youtube.com/@qataquran"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3 bg-white text-gray-900 rounded-xl font-semibold text-sm hover:bg-emerald-50 transition-colors"
        >
          <Icon name="tabler:brand-youtube" class="w-5 h-5 text-red-600" />
          <span>YouTube @qataquran</span>
        </a>
        <a
          href="https://id.pinterest.com/qataquran/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3 bg-emerald-800 text-white rounded-xl font-semibold text-sm hover:bg-emerald-700 transition-colors"
        >
          <Icon name="tabler:brand-pinterest" class="w-5 h-5 text-amber-300" />
          <span>Pinterest @qataquran</span>
        </a>
        <a
          href="/artikel"
          class="inline-flex items-center gap-2.5 px-6 py-3 bg-amber-400 text-gray-950 rounded-xl font-semibold text-sm hover:bg-amber-300 transition-colors"
        >
          <Icon name="tabler:article" class="w-5 h-5" />
          <span>Baca Artikel & Panduan</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";

const values = [
  {
    title: "Al-Qur'an & As-Sunnah",
    desc: "Seluruh panduan ibadah disandarkan pada dalil nash Al-Qur'an dan sunnah Rasulullah shallallahu 'alaihi wa sallam dengan pemahaman yang shahih.",
    icon: "tabler:book-2",
  },
  {
    title: "Rujukan Resmi Terverifikasi",
    desc: "Menggunakan data mushaf standar Kemenag RI, takhrij hadits mu'tabar, serta jadwal hisab/rukyat resmi kementerian.",
    icon: "tabler:shield-check",
  },
  {
    title: "Mudah & Aksesibel",
    desc: "Didesain ringan, cepat dibuka di berbagai perangkat, tanpa iklan yang mengganggu kekhusyukan dan fokus pembaca.",
    icon: "tabler:device-mobile",
  },
  {
    title: "Inspirasi Berkelanjutan",
    desc: "Menyediakan artikel harian, jadwal kajian ilmiah, dan doa-doa mustajab untuk terus memotivasi perbaikan diri.",
    icon: "tabler:sparkles",
  },
];
---

<Layout
  title={`Tentang Kami - ${SITE.title}`}
  description="Mengenal visi, misi, dan komitmen Perbaiki Sholatmu dalam menyajikan panduan sholat, Al-Qur'an digital, jadwal sholat, dan rujukan ibadah terpercaya."
  canonicalURL={`${SITE.url}/tentang`}
>
  <Header />

  <main id="main-content" role="main" class="max-w-5xl mx-auto px-4 py-14 sm:py-20">
    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-xs font-semibold text-emerald-800 mb-4 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Tentang Perbaiki Sholatmu</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-6 leading-tight">
        Perbaiki Sholatmu Agar Allah Perbaiki Hidupmu
      </h1>
      <p class="text-lg sm:text-xl text-gray-600 leading-relaxed">
        Platform media dakwah digital yang berikhtiar mendampingi kaum muslimin untuk meraih kekhusyukan dan kesempurnaan ibadah sholat sehari-hari sesuai tuntunan Al-Qur'an dan As-Sunnah.
      </p>
    </header>

    <!-- Kutipan Landasan -->
    <section class="mb-16 p-8 sm:p-10 bg-white rounded-3xl border border-gray-200 shadow-sm text-center max-w-3xl mx-auto">
      <p class="text-lg sm:text-xl text-gray-800 italic leading-relaxed font-serif">
        &ldquo;Sesungguhnya amal yang pertama kali dihisab pada seorang hamba pada hari kiamat adalah sholatnya. Maka, jika sholatnya baik, sungguh ia telah beruntung dan berhasil. Dan jika shalatnya rusak, sungguh ia telah gagal dan rugi.&rdquo;
      </p>
      <div class="mt-4 pt-4 border-t border-gray-100 text-xs sm:text-sm text-gray-500 font-medium">
        HR. At-Tirmidzi no. 413, An-Nasa'i no. 465, dishahihkan oleh Syaikh Al-Albani
      </div>
    </section>

    <!-- Visi & Misi -->
    <section class="grid md:grid-cols-2 gap-8 mb-16">
      <div class="p-8 bg-white rounded-3xl border border-gray-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 bg-emerald-50 text-emerald-800 rounded-2xl flex items-center justify-center mb-5">
            <Icon name="tabler:target" class="w-6 h-6" />
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">Visi Kami</h2>
          <p class="text-gray-600 leading-relaxed text-base">
            Menjadi platform panduan ibadah sholat digital terdepan yang terpercaya, menumbuhkan kesadaran umat akan urgensi sholat tepat waktu, serta menghidupkan nilai-nilai kekhusyukan dalam kehidupan sehari-hari.
          </p>
        </div>
      </div>

      <div class="p-8 bg-white rounded-3xl border border-gray-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 bg-emerald-50 text-emerald-800 rounded-2xl flex items-center justify-center mb-5">
            <Icon name="tabler:compass" class="w-6 h-6" />
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-3">Misi Kami</h2>
          <ul class="space-y-3 text-gray-600 text-base leading-relaxed list-disc list-inside">
            <li>Menyajikan panduan tata cara sholat praktis berdasarkan sunnah shahihah.</li>
            <li>Menyediakan perkakas ibadah harian seperti jadwal sholat akurat dan Al-Qur'an 30 juz.</li>
            <li>Menyebarkan artikel pengingat dan hikmah yang aplikatif untuk menjaga keistiqamahan ibadah.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Nilai & Komitmen Kami -->
    <section class="mb-16">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Nilai & Komitmen Layanan</h2>
        <p class="text-gray-600 text-base">
          Prinsip dasar yang kami pegang teguh dalam menghadirkan setiap baris konten dan fitur.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">
        {values.map((v) => (
          <div class="p-6 sm:p-7 bg-white rounded-2xl border border-gray-200 shadow-sm hover:border-gray-300 transition-colors">
            <div class="w-10 h-10 bg-gray-100 text-gray-900 rounded-xl flex items-center justify-center mb-4">
              <Icon name={v.icon} class="w-5 h-5" />
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{v.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Kolaborasi & Media -->
    <section class="p-8 sm:p-10 bg-gray-900 text-white rounded-3xl text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3">Terhubung Bersama Kami</h2>
      <p class="text-gray-300 max-w-xl mx-auto mb-8 text-sm sm:text-base leading-relaxed">
        Ikuti konten dakwah visual dan lantunan tilawah harian kami di media sosial, atau hubungi kami untuk masukan dan saran penyempurnaan platform.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://www.youtube.com/@qataquran"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white text-gray-900 rounded-xl font-semibold text-sm hover:bg-gray-100 transition-colors"
        >
          <Icon name="tabler:brand-youtube" class="w-5 h-5 text-red-600" />
          <span>YouTube @qataquran</span>
        </a>
        <a
          href="https://id.pinterest.com/perbaikisholatmu/"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 text-white rounded-xl font-semibold text-sm hover:bg-white/20 transition-colors border border-white/20"
        >
          <Icon name="tabler:brand-pinterest" class="w-5 h-5 text-red-400" />
          <span>Pinterest Perbaiki Sholatmu</span>
        </a>
        <a
          href="/artikel"
          class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-700 text-white rounded-xl font-semibold text-sm hover:bg-emerald-600 transition-colors"
        >
          <Icon name="tabler:article" class="w-5 h-5" />
          <span>Baca Artikel & Panduan</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`${SITE.title} - Perbaiki Sholatmu Agar Allah Perbaiki Hidupmu`}
  description="Perbaiki Sholatmu Agar Allah Perbaiki Hidupmu. Panduan praktis dan inspirasi harian untuk menjaga kekhusyukan dan menyempurnakan ibadah sholat."
  canonicalURL={SITE.url}
>
  <Header />
  <main id="main-content" role="main">
    <Hero />
    <Features />
    <CTA />
  </main>
  <Footer />
</Layout>

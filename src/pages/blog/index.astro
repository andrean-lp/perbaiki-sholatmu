---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchBloggerPosts, fetchBloggerCategories } from '../../lib/blogger';

const posts = await fetchBloggerPosts();
const categories = await fetchBloggerCategories();

// Hitung jumlah postingan per label
const categoryCounts = categories.reduce<Record<string, number>>((acc, cat) => {
  acc[cat] = posts.filter((p) => p.categories.includes(cat)).length;
  return acc;
}, {});
---

<Layout
  title="Blog & Artikel - Perbaiki Sholatmu"
  description="Kumpulan artikel, hikmah, dan panduan seputar menyempurnakan ibadah sholat dan amalan harian bersumber dari Al-Quran dan Sunnah."
>
  <Header />
  <main id="main-content" class="max-w-6xl mx-auto px-4 py-16">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-xs font-semibold text-emerald-800 mb-4 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Qata Quran Media</span>
        <span class="text-emerald-300">|</span>
        <span>{posts.length} Artikel Tersedia</span>
      </div>
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">
        Artikel & Panduan
      </h1>
      <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
        Kumpulan tulisan dan inspirasi harian untuk terus memperbaiki kualitas dan kekhusyukan sholat kita.
      </p>
    </div>

    <!-- Filter Label / Kategori Blogger -->
    {categories.length > 0 && (
      <div class="mb-12 flex flex-wrap items-center justify-center gap-2 max-w-3xl mx-auto">
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all border shadow-sm cursor-pointer bg-emerald-800 text-white border-emerald-800"
        >
          Semua ({posts.length})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            data-filter={cat.toLowerCase()}
            class="filter-btn px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all border shadow-sm cursor-pointer bg-white text-gray-700 hover:text-emerald-800 hover:bg-emerald-50 border-gray-200"
          >
            {cat} {categoryCounts[cat] > 0 && <span class="opacity-75">({categoryCounts[cat]})</span>}
          </button>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-2xl border border-gray-200 p-8">
        <p class="text-gray-500">Sedang memuat artikel dari Qata Quran...</p>
      </div>
    ) : (
      <div id="posts-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article
            class="post-card bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 flex flex-col group hover:border-gray-300"
            data-categories={JSON.stringify(post.categories.map((c) => c.toLowerCase()))}
          >
            {post.thumbnail && (
              <a href={`/blog/${post.slug}`} class="block aspect-[16/10] bg-gray-100 overflow-hidden relative">
                <img
                  src={post.thumbnail}
                  alt={post.title}
                  loading="lazy"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                />
              </a>
            )}

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <time class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    {new Date(post.published).toLocaleDateString('id-ID', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                  {post.categories.map((cat) => (
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-100">
                      {cat}
                    </span>
                  ))}
                </div>

                <h2 class="text-xl font-bold text-gray-900 group-hover:text-emerald-800 transition-colors line-clamp-2 leading-snug">
                  <a href={`/blog/${post.slug}`} class="focus:outline-none">
                    {post.title}
                  </a>
                </h2>

                {post.excerpt && (
                  <p class="mt-2.5 text-sm text-gray-600 line-clamp-3 leading-relaxed">
                    {post.excerpt}
                  </p>
                )}
              </div>

              <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between">
                <a
                  href={`/blog/${post.slug}`}
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-900 group-hover:text-emerald-700 transition-colors"
                >
                  <span>Baca selengkapnya</span>
                  <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}

        <div id="no-filter-results" class="hidden col-span-full text-center py-16 bg-white rounded-2xl border border-gray-200 p-8">
          <p class="text-gray-600 font-medium text-base">Belum ada artikel untuk label ini.</p>
          <button
            type="button"
            id="reset-filter-btn"
            class="mt-4 inline-flex items-center px-4 py-2 text-sm font-semibold text-emerald-800 bg-emerald-50 rounded-lg border border-emerald-200 hover:bg-emerald-100 transition-colors cursor-pointer"
          >
            Tampilkan Semua Artikel
          </button>
        </div>
      </div>
    )}
  </main>
  <Footer />
</Layout>

<script is:inline>
  function initCategoryFilter() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const postCards = document.querySelectorAll('.post-card');
    const noResults = document.getElementById('no-filter-results');
    const resetBtn = document.getElementById('reset-filter-btn');

    if (!filterButtons.length) return;

    function applyFilter(targetCategory) {
      let visibleCount = 0;
      const normalizedTarget = (targetCategory || 'all').toLowerCase().trim();

      // Update button styling
      filterButtons.forEach((btn) => {
        const btnFilter = (btn.getAttribute('data-filter') || 'all').toLowerCase().trim();
        if (btnFilter === normalizedTarget) {
          btn.classList.add('bg-emerald-800', 'text-white', 'border-emerald-800');
          btn.classList.remove('bg-white', 'text-gray-700', 'hover:text-emerald-800', 'hover:bg-emerald-50', 'border-gray-200');
        } else {
          btn.classList.remove('bg-emerald-800', 'text-white', 'border-emerald-800');
          btn.classList.add('bg-white', 'text-gray-700', 'hover:text-emerald-800', 'hover:bg-emerald-50', 'border-gray-200');
        }
      });

      // Filter articles
      postCards.forEach((card) => {
        let cardCategories = [];
        try {
          cardCategories = JSON.parse(card.getAttribute('data-categories') || '[]');
        } catch {
          cardCategories = [];
        }

        if (normalizedTarget === 'all' || cardCategories.includes(normalizedTarget)) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }

      // Update URL query string without reloading
      const url = new URL(window.location.href);
      if (normalizedTarget === 'all') {
        url.searchParams.delete('label');
      } else {
        url.searchParams.set('label', targetCategory);
      }
      window.history.replaceState({}, '', url.toString());
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-filter') || 'all';
        applyFilter(cat);
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        applyFilter('all');
      });
    }

    // Check URL params on initial load (e.g. ?label=Sholat)
    const params = new URLSearchParams(window.location.search);
    const labelParam = params.get('label');
    if (labelParam) {
      applyFilter(labelParam);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCategoryFilter);
  } else {
    initCategoryFilter();
  }
</script>

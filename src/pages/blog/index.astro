---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog & Artikel - Perbaiki Sholatmu"
  description="Kumpulan artikel dan panduan seputar menyempurnakan ibadah sholat."
>
  <Header />
  <main id="main-content" class="max-w-5xl mx-auto px-4 py-16">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">Artikel & Panduan</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Kumpulan tulisan dan pengingat untuk terus memperbaiki kualitas sholat kita sehari-hari.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block bg-white rounded-2xl border border-gray-200 p-6 hover:shadow-lg transition-all duration-200 hover:-translate-y-1"
        >
          <time class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
            {new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
          <h2 class="mt-3 text-xl font-bold text-gray-900 group-hover:text-black">
            {post.data.title}
          </h2>
          {post.data.description && (
            <p class="mt-2 text-sm text-gray-600 line-clamp-3">
              {post.data.description}
            </p>
          )}
          <span class="mt-4 inline-flex items-center text-sm font-medium text-black group-hover:underline">
            Baca selengkapnya &rarr;
          </span>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

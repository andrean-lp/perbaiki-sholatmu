---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchBloggerPosts, type BloggerPost } from '../../lib/blogger';

export async function getStaticPaths() {
  const posts = await fetchBloggerPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BloggerPost;
}

const { post } = Astro.props;

// Check if the HTML content already contains an <img> tag to avoid duplicate & cropped headers
const contentHasImage = post.content ? post.content.includes('<img') : false;
---

<Layout
  title={`${post.title} - Perbaiki Sholatmu`}
  description={post.excerpt}
  ogImage={post.thumbnail || undefined}
  ogType="article"
>
  <Header />
  <main id="main-content" class="max-w-3xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors"
      >
        <span>&larr;</span>
        <span>Kembali ke daftar artikel</span>
      </a>
    </div>

    <article>
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-3 flex-wrap">
          <time class="text-sm font-semibold text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-md border border-emerald-100 uppercase tracking-wider">
            {new Date(post.published).toLocaleDateString('id-ID', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {post.categories.map((cat) => (
            <span class="text-xs font-medium text-gray-600 bg-gray-100 px-2 py-0.5 rounded-md">
              {cat}
            </span>
          ))}
        </div>

        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight sm:text-4xl md:text-5xl leading-tight">
          {post.title}
        </h1>

        <div class="mt-4 flex items-center gap-2 text-sm text-gray-500">
          <span>Ditulis oleh</span>
          <span class="font-semibold text-gray-800">{post.author}</span>
        </div>
      </header>

      {/* Hanya tampilkan thumbnail jika isi artikel belum memiliki gambar apa pun */}
      {!contentHasImage && post.thumbnail && (
        <div class="mb-10 rounded-2xl overflow-hidden bg-gray-100 border border-gray-200 shadow-sm">
          <img
            src={post.thumbnail}
            alt={post.title}
            class="w-full h-auto object-contain rounded-2xl"
          />
        </div>
      )}

      <!-- Konten Artikel dari Blogger -->
      <div
        class="prose prose-lg max-w-none prose-emerald prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-700 hover:prose-a:text-emerald-800"
        set:html={post.content}
      />

      <!-- Rujukan & Sumber Artikel -->
      <div class="mt-16 pt-8 border-t border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gray-50 p-6 rounded-2xl text-xs sm:text-sm text-gray-600">
        <div>
          <span class="font-semibold text-gray-900 block mb-0.5">Sumber Publikasi:</span>
          <span>Dipublikasikan pertama kali melalui portal <strong class="text-gray-900">Qata Quran</strong>.</span>
        </div>
        {post.originalUrl && (
          <a
            href={post.originalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-semibold text-emerald-700 hover:text-emerald-800 underline shrink-0"
          >
            <span>Buka di Blogspot</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Menjaga agar gambar infografis dan konten Blogger tampil utuh & tidak terpotong */
  .prose .separator {
    clear: both;
    text-align: center;
    margin: 2rem auto;
  }
  .prose .separator a {
    display: inline-block;
    margin: 0 auto;
  }
  .prose img {
    max-width: 100% !important;
    height: auto !important;
    margin: 1.5rem auto !important;
    display: block !important;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
  }
  .prose iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1rem;
    margin: 1.5rem auto;
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import QuranApp from "../components/QuranApp.tsx";
import type { SurahItem } from "../components/QuranApp.tsx";
import suratRawData from "../data/surat.json";

const suratList = suratRawData as unknown as SurahItem[];
---

<Layout
  title="Al-Qur'an 30 Juz Digital & Murottal - Perbaiki Sholatmu"
  description="Jelajahi 114 surat Al-Quran lengkap dengan tulisan Arab, terjemahan bahasa Indonesia, asbabun nuzul, dan lantunan murottal dari qari internasional."
>
  <Header />
  <main id="main-content" class="bg-gray-50 min-h-screen text-gray-900 py-10 sm:py-16">
    <QuranApp client:load initialSuratList={suratList} />
  </main>
  <Footer />
</Layout>
